@page "/"
@attribute [Authorize]

<PageTitle>Sistema POS - Inicio</PageTitle>

<AuthorizeView>
    <Authorized Context="authContext">
        <div class="mb-4">
            <h1><i class="bi bi-speedometer2"></i> Panel de Control</h1>
            <p class="text-muted">Bienvenido, <strong>@authContext.User.Identity?.Name</strong>. Selecciona una opcion para comenzar.</p>
        </div>

        <div class="row g-3">
            <AuthorizeView Roles="Administrador">
                <Authorized Context="adminCtx">
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/ventas/nueva" class="dashboard-card">
                            <div class="card-icon green">
                                <i class="bi bi-cart-plus-fill"></i>
                            </div>
                            <h5>Nueva Venta</h5>
                            <small class="text-muted">Registrar venta</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/ventas/historial" class="dashboard-card">
                            <div class="card-icon blue">
                                <i class="bi bi-receipt"></i>
                            </div>
                            <h5>Historial</h5>
                            <small class="text-muted">Consultar ventas</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/caja" class="dashboard-card">
                            <div class="card-icon orange">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <h5>Caja</h5>
                            <small class="text-muted">Apertura y cierre</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/reportes" class="dashboard-card">
                            <div class="card-icon purple">
                                <i class="bi bi-bar-chart-fill"></i>
                            </div>
                            <h5>Reportes</h5>
                            <small class="text-muted">Estadisticas</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/productos" class="dashboard-card">
                            <div class="card-icon teal">
                                <i class="bi bi-box-seam-fill"></i>
                            </div>
                            <h5>Productos</h5>
                            <small class="text-muted">Inventario</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/categorias" class="dashboard-card">
                            <div class="card-icon blue">
                                <i class="bi bi-tags-fill"></i>
                            </div>
                            <h5>Categorias</h5>
                            <small class="text-muted">Clasificaciones</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/usuarios" class="dashboard-card">
                            <div class="card-icon red">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <h5>Usuarios</h5>
                            <small class="text-muted">Gestionar accesos</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/medios-pago" class="dashboard-card">
                            <div class="card-icon green">
                                <i class="bi bi-credit-card-fill"></i>
                            </div>
                            <h5>Medios de Pago</h5>
                            <small class="text-muted">Configurar pagos</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/facturacion" class="dashboard-card">
                            <div class="card-icon orange">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </div>
                            <h5>Facturacion</h5>
                            <small class="text-muted">AFIP / Comprobantes</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="/auditoria" class="dashboard-card">
                            <div class="card-icon purple">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <h5>Auditoria</h5>
                            <small class="text-muted">Historial de cambios</small>
                        </a>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Vendedor">
                <Authorized Context="vendedorCtx">
                    <div class="col-6 col-md-4">
                        <a href="/ventas/nueva" class="dashboard-card">
                            <div class="card-icon green">
                                <i class="bi bi-cart-plus-fill"></i>
                            </div>
                            <h5>Nueva Venta</h5>
                            <small class="text-muted">Registrar una venta</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4">
                        <a href="/ventas/historial" class="dashboard-card">
                            <div class="card-icon blue">
                                <i class="bi bi-receipt"></i>
                            </div>
                            <h5>Mis Ventas</h5>
                            <small class="text-muted">Ver historial</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4">
                        <a href="/caja" class="dashboard-card">
                            <div class="card-icon orange">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <h5>Caja</h5>
                            <small class="text-muted">Estado actual</small>
                        </a>
                    </div>
                    <div class="col-6 col-md-4">
                        <a href="/productos" class="dashboard-card">
                            <div class="card-icon teal">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <h5>Productos</h5>
                            <small class="text-muted">Consultar catalogo</small>
                        </a>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </Authorized>
</AuthorizeView>
