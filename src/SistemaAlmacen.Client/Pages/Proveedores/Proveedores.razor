@page "/proveedores"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Gestión de Proveedores</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="alert alert-success" role="alert">@_successMessage</div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <input type="text" class="form-control" placeholder="Buscar por nombre, CUIT o email..."
               @bind="_searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
    </div>
    <div class="col-md-6 text-end">
        <button class="btn btn-outline-primary me-2" @onclick="ApplyFilter">Buscar</button>
        <button class="btn btn-primary" @onclick="NavigateToCreate">Nuevo Proveedor</button>
    </div>
</div>

@if (_isLoading)
{
    <p>Cargando proveedores...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>CUIT</th>
                <th>Cond. IVA</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _proveedores)
            {
                <tr>
                    <td>@p.Nombre</td>
                    <td>@(string.IsNullOrEmpty(p.Cuit) ? "-" : p.Cuit)</td>
                    <td>@FormatCondicionIva(p.CondicionIva)</td>
                    <td>@(string.IsNullOrEmpty(p.Telefono) ? "-" : p.Telefono)</td>
                    <td>@(string.IsNullOrEmpty(p.Email) ? "-" : p.Email)</td>
                    <td>
                        <button class="btn btn-warning btn-sm" @onclick="() => NavigateToEdit(p.Id)">Editar</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteProveedor(p)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_proveedores.Count == 0)
    {
        <p class="text-muted">No se encontraron proveedores.</p>
    }

    @if (_totalPages > 1)
    {
        <nav aria-label="Paginación de proveedores">
            <ul class="pagination">
                <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="PreviousPage" disabled="@(_currentPage <= 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= _totalPages; i++)
                {
                    var pageNum = i;
                    <li class="page-item @(_currentPage == pageNum ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    </li>
                }
                <li class="page-item @(_currentPage >= _totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="NextPage" disabled="@(_currentPage >= _totalPages)">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private List<ProveedorDto> _proveedores = new();
    private string? _searchTerm;
    private int _currentPage = 1;
    private int _totalPages;
    private const int PageSize = 20;
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProveedores();
    }

    private async Task LoadProveedores()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var queryParams = new List<string>
            {
                $"page={_currentPage}",
                $"pageSize={PageSize}"
            };

            if (!string.IsNullOrWhiteSpace(_searchTerm))
                queryParams.Add($"searchTerm={Uri.EscapeDataString(_searchTerm)}");

            var url = $"api/proveedores?{string.Join("&", queryParams)}";
            var result = await Http.GetFromJsonAsync<PaginatedResult<ProveedorDto>>(url);

            if (result is not null)
            {
                _proveedores = result.Items;
                _totalPages = result.TotalPages;
            }
            else
            {
                _proveedores = new();
                _totalPages = 0;
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error al cargar los proveedores. Intente nuevamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatCondicionIva(CondicionIva c) => c switch
    {
        CondicionIva.ConsumidorFinal => "Consumidor Final",
        CondicionIva.ResponsableInscripto => "Responsable Inscripto",
        CondicionIva.Monotributista => "Monotributista",
        CondicionIva.Exento => "Exento",
        _ => c.ToString()
    };

    private async Task ApplyFilter()
    {
        _currentPage = 1;
        await LoadProveedores();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ApplyFilter();
    }

    private async Task GoToPage(int page) { _currentPage = page; await LoadProveedores(); }
    private async Task PreviousPage() { if (_currentPage > 1) { _currentPage--; await LoadProveedores(); } }
    private async Task NextPage() { if (_currentPage < _totalPages) { _currentPage++; await LoadProveedores(); } }

    private void NavigateToCreate() => Navigation.NavigateTo("/proveedores/crear");
    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/proveedores/editar/{id}");

    private async Task DeleteProveedor(ProveedorDto proveedor)
    {
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var response = await Http.DeleteAsync($"api/proveedores/{proveedor.Id}");

            if (response.IsSuccessStatusCode)
            {
                _successMessage = $"Proveedor '{proveedor.Nombre}' eliminado exitosamente.";
                await LoadProveedores();
            }
            else
            {
                var errorResult = await ApiErrorParser.ParseAsync(response);
                _errorMessage = errorResult.GeneralError ?? "Error al eliminar el proveedor.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error de conexión. Intente nuevamente.";
        }
    }
}
