@page "/caja"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Gestión de Caja</h3>

@if (_isLoading)
{
    <p>Cargando estado de caja...</p>
}
else if (_cajaAbierta is not null)
{
    <div class="card mb-3">
        <div class="card-header bg-success text-white">
            <strong>Caja Abierta</strong>
        </div>
        <div class="card-body">
            <p><strong>Punto de Venta:</strong> @_cajaAbierta.PuntoDeVentaId</p>
            <p><strong>Abierta por:</strong> @_cajaAbierta.UsuarioApertura</p>
            <p><strong>Fecha de Apertura:</strong> @_cajaAbierta.FechaApertura.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Monto Inicial:</strong> $@_cajaAbierta.MontoInicial.ToString("N2")</p>
        </div>
    </div>

    @* Movimientos del periodo *@
    <div class="card mb-3">
        <div class="card-header">
            <strong>Movimientos del Período</strong>
        </div>
        <div class="card-body">
            @if (_movimientos.Count == 0)
            {
                <p class="text-muted">No hay movimientos registrados en este período.</p>
            }
            else
            {
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Monto</th>
                            <th>Motivo</th>
                            <th>Usuario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mov in _movimientos)
                        {
                            <tr>
                                <td>@mov.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@GetTipoMovimientoLabel(mov.Tipo)</td>
                                <td class="@(EsIngreso(mov.Tipo) ? "text-success" : "text-danger")">
                                    @(EsIngreso(mov.Tipo) ? "+" : "-")$@mov.Monto.ToString("N2")
                                </td>
                                <td>@mov.Motivo</td>
                                <td>@mov.Usuario</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* Formulario de Retiro *@
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Registrar Retiro</div>
                <div class="card-body">
                    <EditForm Model="@_retiroModel" OnValidSubmit="HandleRetiro" FormName="retiroForm">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(_retiroError))
                        {
                            <div class="alert alert-danger">@_retiroError</div>
                        }

                        <div class="form-group mb-2">
                            <label for="retiroMonto">Monto</label>
                            <InputNumber id="retiroMonto" class="form-control" @bind-Value="_retiroModel.Monto" />
                            <ValidationMessage For="@(() => _retiroModel.Monto)" />
                        </div>
                        <div class="form-group mb-2">
                            <label for="retiroMotivo">Motivo</label>
                            <InputText id="retiroMotivo" class="form-control" @bind-Value="_retiroModel.Motivo" />
                            <ValidationMessage For="@(() => _retiroModel.Motivo)" />
                        </div>
                        <button type="submit" class="btn btn-warning" disabled="@_isSubmitting">
                            @(_isSubmitting ? "Registrando..." : "Registrar Retiro")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        @* Formulario de Ingreso *@
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Registrar Ingreso</div>
                <div class="card-body">
                    <EditForm Model="@_ingresoModel" OnValidSubmit="HandleIngreso" FormName="ingresoForm">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(_ingresoError))
                        {
                            <div class="alert alert-danger">@_ingresoError</div>
                        }

                        <div class="form-group mb-2">
                            <label for="ingresoMonto">Monto</label>
                            <InputNumber id="ingresoMonto" class="form-control" @bind-Value="_ingresoModel.Monto" />
                            <ValidationMessage For="@(() => _ingresoModel.Monto)" />
                        </div>
                        <div class="form-group mb-2">
                            <label for="ingresoMotivo">Motivo</label>
                            <InputText id="ingresoMotivo" class="form-control" @bind-Value="_ingresoModel.Motivo" />
                            <ValidationMessage For="@(() => _ingresoModel.Motivo)" />
                        </div>
                        <button type="submit" class="btn btn-success" disabled="@_isSubmitting">
                            @(_isSubmitting ? "Registrando..." : "Registrar Ingreso")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>

    @* Formulario de Cierre de Caja *@
    <div class="card mb-3">
        <div class="card-header bg-danger text-white">
            <strong>Cerrar Caja</strong>
        </div>
        <div class="card-body">
            <EditForm Model="@_cerrarModel" OnValidSubmit="HandleCerrar" FormName="cerrarCajaForm">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_cerrarError))
                {
                    <div class="alert alert-danger">@_cerrarError</div>
                }

                @if (_cierreResumen is not null)
                {
                    <div class="alert alert-info">
                        <h5>Resumen de Cierre</h5>
                        <p><strong>Monto Apertura:</strong> $@_cierreResumen.MontoInicial.ToString("N2")</p>
                        <p><strong>Saldo Esperado:</strong> $@_cierreResumen.SaldoEsperado.ToString("N2")</p>
                        <p><strong>Monto Real:</strong> $@_cierreResumen.MontoRealCierre.ToString("N2")</p>
                        <p><strong>Diferencia:</strong>
                            <span class="@(_cierreResumen.Diferencia >= 0 ? "text-success" : "text-danger")">
                                $@_cierreResumen.Diferencia.ToString("N2")
                            </span>
                            @if (_cierreResumen.DiferenciaSignificativa)
                            {
                                <span class="badge bg-danger ms-2">Diferencia significativa</span>
                            }
                        </p>
                    </div>
                }

                <div class="form-group mb-2">
                    <label for="montoRealCierre">Monto Real en Caja (conteo de efectivo)</label>
                    <InputNumber id="montoRealCierre" class="form-control" @bind-Value="_cerrarModel.MontoRealCierre" />
                    <ValidationMessage For="@(() => _cerrarModel.MontoRealCierre)" />
                </div>
                <button type="submit" class="btn btn-danger" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Cerrando..." : "Cerrar Caja")
                </button>
            </EditForm>
        </div>
    </div>
}
else
{
    @* No hay caja abierta - Mostrar botón para abrir *@
    <div class="card mb-3">
        <div class="card-header bg-secondary text-white">
            <strong>Caja Cerrada</strong>
        </div>
        <div class="card-body">
            <p class="text-muted">No hay una caja abierta actualmente. Abra una caja para comenzar a operar.</p>

            <EditForm Model="@_abrirModel" OnValidSubmit="HandleAbrir" FormName="abrirCajaForm">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_abrirError))
                {
                    <div class="alert alert-danger">@_abrirError</div>
                }

                <div class="form-group mb-2">
                    <label for="montoInicial">Monto Inicial</label>
                    <InputNumber id="montoInicial" class="form-control" @bind-Value="_abrirModel.MontoInicial" />
                    <ValidationMessage For="@(() => _abrirModel.MontoInicial)" />
                </div>
                <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Abriendo..." : "Abrir Caja")
                </button>
            </EditForm>
        </div>
    </div>
}

<div class="mt-3">
    <a href="/caja/historial-cierres" class="btn btn-outline-secondary">Ver Historial de Cierres</a>
</div>

@code {
    private bool _isLoading = true;
    private bool _isSubmitting;

    private CajaDto? _cajaAbierta;
    private List<MovimientoDto> _movimientos = new();
    private CierreResumenDto? _cierreResumen;

    private AbrirCajaRequest _abrirModel = new() { PuntoDeVentaId = 1 };
    private MovimientoRequest _retiroModel = new();
    private MovimientoRequest _ingresoModel = new();
    private CerrarCajaRequest _cerrarModel = new();

    private string? _abrirError;
    private string? _retiroError;
    private string? _ingresoError;
    private string? _cerrarError;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadoCaja();
    }

    private async Task CargarEstadoCaja()
    {
        _isLoading = true;
        try
        {
            var response = await Http.GetAsync("api/caja/actual?puntoDeVentaId=1");
            if (response.IsSuccessStatusCode)
            {
                _cajaAbierta = await response.Content.ReadFromJsonAsync<CajaDto>();
                await CargarMovimientos();
            }
            else
            {
                _cajaAbierta = null;
                _movimientos.Clear();
            }
        }
        catch
        {
            _cajaAbierta = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CargarMovimientos()
    {
        try
        {
            // Fetch history for this open caja period by querying historial-cierres
            // Since there's no dedicated movements endpoint, we use the closing history.
            // For the open caja, movements come from the cierre resumen.
            // As a workaround, we'll attempt to get movements from current session.
            var response = await Http.GetAsync(
                $"api/caja/historial-cierres?fechaInicio={_cajaAbierta!.FechaApertura:yyyy-MM-dd}&page=1&pageSize=1");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PaginatedResult<CierreResumenDto>>();
                if (result?.Items.Count > 0)
                {
                    _movimientos = result.Items[0].Movimientos;
                }
            }
        }
        catch
        {
            // If we can't load movements, show empty
            _movimientos = new();
        }
    }

    private async Task HandleAbrir()
    {
        _isSubmitting = true;
        _abrirError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/caja/abrir", _abrirModel);
            if (response.IsSuccessStatusCode)
            {
                _abrirModel = new() { PuntoDeVentaId = 1 };
                await CargarEstadoCaja();
            }
            else
            {
                var error = await ApiErrorParser.ParseAsync(response);
                _abrirError = error.GeneralError ?? "Error al abrir la caja.";
            }
        }
        catch
        {
            _abrirError = "Error de conexión. Intente nuevamente.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleRetiro()
    {
        _isSubmitting = true;
        _retiroError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/caja/retiro", _retiroModel);
            if (response.IsSuccessStatusCode)
            {
                _retiroModel = new();
                await CargarEstadoCaja();
            }
            else
            {
                var error = await ApiErrorParser.ParseAsync(response);
                _retiroError = error.GeneralError ?? "Error al registrar el retiro.";
            }
        }
        catch
        {
            _retiroError = "Error de conexión. Intente nuevamente.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleIngreso()
    {
        _isSubmitting = true;
        _ingresoError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/caja/ingreso", _ingresoModel);
            if (response.IsSuccessStatusCode)
            {
                _ingresoModel = new();
                await CargarEstadoCaja();
            }
            else
            {
                var error = await ApiErrorParser.ParseAsync(response);
                _ingresoError = error.GeneralError ?? "Error al registrar el ingreso.";
            }
        }
        catch
        {
            _ingresoError = "Error de conexión. Intente nuevamente.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleCerrar()
    {
        _isSubmitting = true;
        _cerrarError = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/caja/cerrar", _cerrarModel);
            if (response.IsSuccessStatusCode)
            {
                _cierreResumen = await response.Content.ReadFromJsonAsync<CierreResumenDto>();
                // After showing summary, reload state
                await CargarEstadoCaja();
            }
            else
            {
                var error = await ApiErrorParser.ParseAsync(response);
                _cerrarError = error.GeneralError ?? "Error al cerrar la caja.";
            }
        }
        catch
        {
            _cerrarError = "Error de conexión. Intente nuevamente.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static string GetTipoMovimientoLabel(TipoMovimiento tipo) => tipo switch
    {
        TipoMovimiento.Apertura => "Apertura",
        TipoMovimiento.VentaEfectivo => "Venta Efectivo",
        TipoMovimiento.Retiro => "Retiro",
        TipoMovimiento.IngresoAdicional => "Ingreso Adicional",
        _ => tipo.ToString()
    };

    private static bool EsIngreso(TipoMovimiento tipo) =>
        tipo == TipoMovimiento.Apertura ||
        tipo == TipoMovimiento.VentaEfectivo ||
        tipo == TipoMovimiento.IngresoAdicional;
}
