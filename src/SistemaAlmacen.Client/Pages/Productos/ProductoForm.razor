@page "/productos/crear"
@page "/productos/editar/{Id:int}"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>@(_isEdit ? "Editar Producto" : "Nuevo Producto")</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (_isLoadingProduct)
{
    <p>Cargando producto...</p>
}
else
{
    <EditForm Model="@_model" OnValidSubmit="HandleSubmit" FormName="productoForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <InputText id="nombre" class="form-control" @bind-Value="_model.Nombre" />
            <ValidationMessage For="@(() => _model.Nombre)" />
        </div>

        <div class="mb-3">
            <label for="codigoBarras" class="form-label">Código de Barras</label>
            <InputText id="codigoBarras" class="form-control" @bind-Value="_model.CodigoBarras" placeholder="Escanear o ingresar manualmente" />
            <ValidationMessage For="@(() => _model.CodigoBarras)" />
        </div>

        <div class="mb-3">
            <label for="descripcion" class="form-label">Descripción</label>
            <InputTextArea id="descripcion" class="form-control" @bind-Value="_model.Descripcion" rows="3" />
            <ValidationMessage For="@(() => _model.Descripcion)" />
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label for="precio" class="form-label">Precio de venta</label>
                <InputNumber id="precio" class="form-control" @bind-Value="_model.Precio" />
                <ValidationMessage For="@(() => _model.Precio)" />
            </div>
            <div class="col-md-4 mb-3">
                <label for="precioCosto" class="form-label">Precio de costo</label>
                <InputNumber id="precioCosto" class="form-control" @bind-Value="_model.PrecioCosto" />
                <ValidationMessage For="@(() => _model.PrecioCosto)" />
            </div>
            <div class="col-md-4 mb-3">
                <label for="margen" class="form-label">Margen % (opcional)</label>
                <InputNumber id="margen" class="form-control" @bind-Value="_model.MargenGanancia" placeholder="Hereda de categoría" />
                <ValidationMessage For="@(() => _model.MargenGanancia)" />
                <small class="text-muted">Si se deja vacío, usa el margen de la categoría o el predeterminado.</small>
            </div>
        </div>

        <div class="mb-3">
            <label for="stock" class="form-label">Stock</label>
            <InputNumber id="stock" class="form-control" @bind-Value="_model.Stock" />
            <ValidationMessage For="@(() => _model.Stock)" />
        </div>

        <div class="mb-3">
            <label for="categoria" class="form-label">Categoría</label>
            <InputSelect id="categoria" class="form-select" @bind-Value="_model.CategoriaId">
                <option value="0">-- Seleccione una categoría --</option>
                @foreach (var cat in _categorias)
                {
                    <option value="@cat.Id">@cat.Nombre</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => _model.CategoriaId)" />
        </div>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span>Guardando...</span>
                }
                else
                {
                    <span>@(_isEdit ? "Actualizar" : "Crear")</span>
                }
            </button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="NavigateBack">
                Cancelar
            </button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductoFormModel _model = new();
    private List<CategoriaDto> _categorias = new();
    private bool _isEdit;
    private bool _isLoadingProduct;
    private bool _isSaving;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _isEdit = Id > 0;
        await LoadCategorias();

        if (_isEdit)
        {
            await LoadProducto();
        }
    }

    private async Task LoadCategorias()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<CategoriaDto>>("api/categorias");
            _categorias = result ?? new();
        }
        catch
        {
            _errorMessage = "Error al cargar las categorías.";
        }
    }

    private async Task LoadProducto()
    {
        _isLoadingProduct = true;

        try
        {
            var producto = await Http.GetFromJsonAsync<ProductoDto>($"api/productos/{Id}");

            if (producto is not null)
            {
                _model = new ProductoFormModel
                {
                    Nombre = producto.Nombre,
                    CodigoBarras = producto.CodigoBarras,
                    Descripcion = producto.Descripcion,
                    Precio = producto.Precio,
                    PrecioCosto = producto.PrecioCosto,
                    MargenGanancia = producto.MargenGanancia,
                    Stock = producto.Stock,
                    CategoriaId = producto.CategoriaId
                };
            }
            else
            {
                _errorMessage = "Producto no encontrado.";
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _errorMessage = "Producto no encontrado.";
        }
        catch (Exception)
        {
            _errorMessage = "Error al cargar el producto.";
        }
        finally
        {
            _isLoadingProduct = false;
        }
    }

    private async Task HandleSubmit()
    {
        _isSaving = true;
        _errorMessage = null;

        try
        {
            HttpResponseMessage response;

            if (_isEdit)
            {
                var request = new UpdateProductoRequest
                {
                    Nombre = _model.Nombre,
                    CodigoBarras = _model.CodigoBarras,
                    Descripcion = _model.Descripcion,
                    Precio = _model.Precio,
                    PrecioCosto = _model.PrecioCosto,
                    MargenGanancia = _model.MargenGanancia,
                    Stock = _model.Stock,
                    CategoriaId = _model.CategoriaId
                };
                response = await Http.PutAsJsonAsync($"api/productos/{Id}", request);
            }
            else
            {
                var request = new CreateProductoRequest
                {
                    Nombre = _model.Nombre,
                    CodigoBarras = _model.CodigoBarras,
                    Descripcion = _model.Descripcion,
                    Precio = _model.Precio,
                    PrecioCosto = _model.PrecioCosto,
                    MargenGanancia = _model.MargenGanancia,
                    Stock = _model.Stock,
                    CategoriaId = _model.CategoriaId
                };
                response = await Http.PostAsJsonAsync("api/productos", request);
            }

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/productos");
            }
            else
            {
                var errorResult = await ApiErrorParser.ParseAsync(response);
                _errorMessage = errorResult.GeneralError ?? "Error al guardar el producto.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error de conexión. Intente nuevamente.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/productos");
    }

    /// <summary>
    /// Internal form model used by EditForm to bind both create and edit scenarios.
    /// </summary>
    private class ProductoFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es requerido.")]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = "El nombre no puede exceder 100 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.MaxLength(50, ErrorMessage = "El código de barras no puede exceder 50 caracteres.")]
        public string? CodigoBarras { get; set; }

        [System.ComponentModel.DataAnnotations.MaxLength(500, ErrorMessage = "La descripción no puede exceder 500 caracteres.")]
        public string? Descripcion { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El precio es requerido.")]
        [System.ComponentModel.DataAnnotations.Range(0.01, 999999999.99, ErrorMessage = "El precio debe estar entre 0.01 y 999,999,999.99.")]
        public decimal Precio { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, 999999999.99, ErrorMessage = "El precio de costo debe estar entre 0 y 999,999,999.99.")]
        public decimal PrecioCosto { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, 999.99, ErrorMessage = "El margen debe estar entre 0 y 999.99.")]
        public decimal? MargenGanancia { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El stock es requerido.")]
        [System.ComponentModel.DataAnnotations.Range(0, int.MaxValue, ErrorMessage = "El stock debe ser mayor o igual a cero.")]
        public int Stock { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La categoría es requerida.")]
        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue, ErrorMessage = "Debe seleccionar una categoría.")]
        public int CategoriaId { get; set; }
    }
}
