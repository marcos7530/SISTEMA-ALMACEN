@page "/usuarios"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Gestión de Usuarios</h3>

<div class="toolbar">
    <div class="search-box">
        <input type="text" class="form-control" placeholder="Buscar por nombre o email..."
               @bind="_searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
        <select class="form-select" style="max-width: 180px;" @bind="_estadoFiltro" @bind:after="SearchAsync">
            <option value="activos">Activos</option>
            <option value="inactivos">Inhabilitados</option>
            <option value="todos">Todos</option>
        </select>
        <button class="btn btn-secondary" @onclick="SearchAsync">Buscar</button>
    </div>
    <button class="btn btn-primary" @onclick="NuevoUsuario">Nuevo Usuario</button>
</div>

@if (_isLoading)
{
    <p>Cargando...</p>
}
else if (_result == null || !_result.Items.Any())
{
    <p>No se encontraron usuarios.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in _result.Items)
            {
                <tr>
                    <td>@usuario.Nombre</td>
                    <td>@usuario.Email</td>
                    <td>@usuario.Rol.ToString()</td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   checked="@usuario.Activo"
                                   disabled="@(_togglingId == usuario.Id)"
                                   @onchange="@(e => CambiarEstado(usuario, (bool)e.Value!))" />
                            <span class="@(usuario.Activo ? "text-success" : "text-muted")">
                                @(usuario.Activo ? "Habilitado" : "Inhabilitado")
                            </span>
                        </div>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => EditarUsuario(usuario.Id)">Editar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        <button class="btn btn-sm btn-outline-primary" disabled="@(_currentPage <= 1)" @onclick="PaginaAnterior">
            Anterior
        </button>
        <span>Página @_currentPage de @_result.TotalPages</span>
        <button class="btn btn-sm btn-outline-primary" disabled="@(_currentPage >= _result.TotalPages)" @onclick="PaginaSiguiente">
            Siguiente
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-3">@_errorMessage</div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success mt-3">@_successMessage</div>
}

@code {
    private PaginatedResult<UsuarioDto>? _result;
    private string _searchTerm = string.Empty;
    private string _estadoFiltro = "activos"; // activos | inactivos | todos
    private int _currentPage = 1;
    private const int PageSize = 10;
    private bool _isLoading;
    private int? _togglingId;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsuariosAsync();
    }

    private async Task LoadUsuariosAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var url = $"api/usuarios?Page={_currentPage}&PageSize={PageSize}";
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                url += $"&SearchTerm={Uri.EscapeDataString(_searchTerm)}";
            }

            // Filtro de estado: activos (true), inactivos (false), todos (sin parámetro).
            if (_estadoFiltro == "activos")
                url += "&activo=true";
            else if (_estadoFiltro == "inactivos")
                url += "&activo=false";

            _result = await Http.GetFromJsonAsync<PaginatedResult<UsuarioDto>>(url);
        }
        catch (Exception)
        {
            _errorMessage = "Error al cargar los usuarios. Intente nuevamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SearchAsync()
    {
        _currentPage = 1;
        await LoadUsuariosAsync();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task PaginaAnterior()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadUsuariosAsync();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (_result != null && _currentPage < _result.TotalPages)
        {
            _currentPage++;
            await LoadUsuariosAsync();
        }
    }

    private void NuevoUsuario()
    {
        Navigation.NavigateTo("/usuarios/nuevo");
    }

    private void EditarUsuario(int id)
    {
        Navigation.NavigateTo($"/usuarios/editar/{id}");
    }

    private async Task CambiarEstado(UsuarioDto usuario, bool nuevoEstado)
    {
        _togglingId = usuario.Id;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var request = new CambiarEstadoUsuarioRequest { Activo = nuevoEstado };
            var response = await Http.PatchAsJsonAsync($"api/usuarios/{usuario.Id}/estado", request);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = nuevoEstado
                    ? $"Usuario '{usuario.Nombre}' habilitado."
                    : $"Usuario '{usuario.Nombre}' inhabilitado.";
                await LoadUsuariosAsync();
            }
            else
            {
                // Falló: recargar para revertir el switch al estado real y mostrar el motivo.
                var errorResult = await ApiErrorParser.ParseAsync(response);
                _errorMessage = errorResult.GeneralError ?? "No se pudo cambiar el estado del usuario.";
                await LoadUsuariosAsync();
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error de conexión. Intente nuevamente.";
            await LoadUsuariosAsync();
        }
        finally
        {
            _togglingId = null;
        }
    }
}
