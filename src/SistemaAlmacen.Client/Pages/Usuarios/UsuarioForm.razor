@page "/usuarios/nuevo"
@page "/usuarios/editar/{Id:int}"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>@(_isEdit ? "Editar Usuario" : "Nuevo Usuario")</h3>

@if (_isLoading)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="@_formModel" OnValidSubmit="HandleSubmit" FormName="usuarioForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">@_errorMessage</div>
        }

        <div class="form-group">
            <label for="nombre">Nombre</label>
            <InputText id="nombre" class="form-control" @bind-Value="_formModel.Nombre" />
            <ValidationMessage For="@(() => _formModel.Nombre)" />
        </div>

        <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <InputText id="email" class="form-control" @bind-Value="_formModel.Email" />
            <ValidationMessage For="@(() => _formModel.Email)" />
        </div>

        @if (!_isEdit)
        {
            <div class="form-group">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_password" />
                @if (!string.IsNullOrEmpty(_passwordError))
                {
                    <div class="validation-message">@_passwordError</div>
                }
            </div>
        }

        <div class="form-group">
            <label for="rol">Rol</label>
            <InputSelect id="rol" class="form-control" @bind-Value="_formModel.Rol">
                <option value="@Rol.Administrador">Administrador</option>
                <option value="@Rol.Vendedor">Vendedor</option>
            </InputSelect>
            <ValidationMessage For="@(() => _formModel.Rol)" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                @(_isSaving ? "Guardando..." : (_isEdit ? "Guardar Cambios" : "Crear Usuario"))
            </button>
            <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private UsuarioFormModel _formModel = new();
    private string _password = string.Empty;
    private string? _passwordError;
    private string? _errorMessage;
    private bool _isEdit;
    private bool _isLoading;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        _isEdit = Id > 0;

        if (_isEdit)
        {
            await LoadUsuarioAsync();
        }
    }

    private async Task LoadUsuarioAsync()
    {
        _isLoading = true;
        try
        {
            var usuario = await Http.GetFromJsonAsync<UsuarioDto>($"api/usuarios/{Id}");
            if (usuario != null)
            {
                _formModel.Nombre = usuario.Nombre;
                _formModel.Email = usuario.Email;
                _formModel.Rol = usuario.Rol;
            }
            else
            {
                _errorMessage = "Usuario no encontrado.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error al cargar el usuario. Intente nuevamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;
        _passwordError = null;

        if (!_isEdit)
        {
            if (string.IsNullOrWhiteSpace(_password))
            {
                _passwordError = "La contraseña es requerida.";
                return;
            }
            if (_password.Length < 8)
            {
                _passwordError = "La contraseña debe tener al menos 8 caracteres.";
                return;
            }
            if (_password.Length > 50)
            {
                _passwordError = "La contraseña no puede exceder 50 caracteres.";
                return;
            }
        }

        _isSaving = true;

        try
        {
            HttpResponseMessage response;

            if (_isEdit)
            {
                var updateRequest = new UpdateUsuarioRequest
                {
                    Nombre = _formModel.Nombre,
                    Email = _formModel.Email,
                    Rol = _formModel.Rol
                };
                response = await Http.PutAsJsonAsync($"api/usuarios/{Id}", updateRequest);
            }
            else
            {
                var createRequest = new CreateUsuarioRequest
                {
                    Nombre = _formModel.Nombre,
                    Email = _formModel.Email,
                    Password = _password,
                    Rol = _formModel.Rol
                };
                response = await Http.PostAsJsonAsync("api/usuarios", createRequest);
            }

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/usuarios");
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                _errorMessage = !string.IsNullOrEmpty(content) ? content : "Error al guardar el usuario.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error de conexión. Intente nuevamente.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/usuarios");
    }

    /// <summary>
    /// Form model that wraps the common fields used in both create and edit scenarios.
    /// </summary>
    private class UsuarioFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es requerido.")]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = "El nombre no puede exceder 100 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El correo electrónico es requerido.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "El formato del correo electrónico no es válido.")]
        [System.ComponentModel.DataAnnotations.MaxLength(254, ErrorMessage = "El correo electrónico no puede exceder 254 caracteres.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El rol es requerido.")]
        public Rol Rol { get; set; } = Rol.Vendedor;
    }
}
