@page "/ventas/historial"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Historial de Ventas</h3>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <label for="fechaInicio">Fecha Inicio</label>
                <input id="fechaInicio" type="date" class="form-control" @bind="_fechaInicio" />
            </div>
            <div class="col-md-4">
                <label for="fechaFin">Fecha Fin</label>
                <input id="fechaFin" type="date" class="form-control" @bind="_fechaFin" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-primary me-2" @onclick="Buscar">Buscar</button>
                <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">Limpiar</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (_isLoading)
{
    <p>Cargando...</p>
}
else if (_ventas.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Vendedor</th>
                <th>Cliente</th>
                <th>Productos</th>
                <th>Total</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in _ventas)
            {
                <tr>
                    <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@v.Vendedor</td>
                    <td>@(string.IsNullOrEmpty(v.ClienteNombre) ? "-" : v.ClienteNombre)</td>
                    <td>@v.CantidadProductos</td>
                    <td>$@v.Total.ToString("N2")</td>
                    <td>
                        @if (v.Estado == EstadoVenta.Anulada)
                        {
                            <span class="badge bg-danger">Anulada</span>
                        }
                        else if (v.Estado == EstadoVenta.PendienteFacturacion)
                        {
                            <span class="badge bg-warning text-dark">Pend. Facturación</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Confirmada</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => VerDetalle(v.Id)">Ver</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <nav>
        <ul class="pagination">
            <li class="page-item @(_page <= 1 ? "disabled" : "")">
                <button class="page-link" @onclick="PaginaAnterior">Anterior</button>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Página @_page de @_totalPages</span>
            </li>
            <li class="page-item @(_page >= _totalPages ? "disabled" : "")">
                <button class="page-link" @onclick="PaginaSiguiente">Siguiente</button>
            </li>
        </ul>
    </nav>
}
else
{
    <p class="text-muted">No se encontraron ventas en el período seleccionado.</p>
}

@code {
    private List<VentaResumenItemDto> _ventas = new();
    private bool _isLoading;
    private string? _errorMessage;

    private DateTime? _fechaInicio;
    private DateTime? _fechaFin;
    private int _page = 1;
    private int _totalPages = 1;
    private const int PageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        await CargarVentas();
    }

    private async Task Buscar()
    {
        _page = 1;
        await CargarVentas();
    }

    private async Task LimpiarFiltros()
    {
        _fechaInicio = null;
        _fechaFin = null;
        _page = 1;
        await CargarVentas();
    }

    private async Task CargarVentas()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var url = $"api/ventas?page={_page}&pageSize={PageSize}";

            if (_fechaInicio.HasValue)
                url += $"&fechaInicio={_fechaInicio.Value:yyyy-MM-dd}";
            if (_fechaFin.HasValue)
                url += $"&fechaFin={_fechaFin.Value:yyyy-MM-dd}";

            var result = await Http.GetFromJsonAsync<PaginatedResultDto<VentaResumenItemDto>>(url);

            if (result is not null)
            {
                _ventas = result.Items;
                _totalPages = result.TotalPages > 0 ? result.TotalPages : 1;
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error al cargar el historial de ventas.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PaginaAnterior()
    {
        if (_page > 1)
        {
            _page--;
            await CargarVentas();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (_page < _totalPages)
        {
            _page++;
            await CargarVentas();
        }
    }

    private void VerDetalle(int ventaId)
    {
        Navigation.NavigateTo($"/ventas/{ventaId}");
    }

    // --- Local DTOs ---
    private class VentaResumenItemDto
    {
        public int Id { get; set; }
        public DateTime Fecha { get; set; }
        public string Vendedor { get; set; } = string.Empty;
        public string? ClienteNombre { get; set; }
        public int CantidadProductos { get; set; }
        public decimal Total { get; set; }
        public EstadoVenta Estado { get; set; }
    }

    private class PaginatedResultDto<T>
    {
        public List<T> Items { get; set; } = new();
        public int TotalCount { get; set; }
        public int Page { get; set; }
        public int PageSize { get; set; }
        public int TotalPages { get; set; }
    }
}
