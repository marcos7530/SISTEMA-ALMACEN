@page "/ventas/nueva"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Nueva Venta</h3>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success">@_successMessage</div>
}

@if (_ventaId is null)
{
    <button class="btn btn-primary" @onclick="IniciarVenta" disabled="@_isLoading">
        @(_isLoading ? "Iniciando..." : "Iniciar Venta")
    </button>
}
else
{
    <div class="row">
        <!-- Product Selection -->
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header"><i class="bi bi-upc-scan"></i> Agregar Producto</div>
                <div class="card-body">
                    <!-- Búsqueda unificada: código de barras o nombre -->
                    <div class="form-group mb-2 position-relative">
                        <label for="buscarProducto"><strong>Buscar producto</strong></label>
                        <input id="buscarProducto" type="text" class="form-control form-control-lg"
                               placeholder="Escanear código o buscar por nombre..."
                               @bind="_busquedaProducto" @bind:event="oninput"
                               @onkeydown="HandleBusquedaKeyDown"
                               autocomplete="off"
                               autofocus />
                        @if (!string.IsNullOrEmpty(_barcodeMessage))
                        {
                            <small class="text-danger">@_barcodeMessage</small>
                        }

                        @if (_productosDisponibles.Any())
                        {
                            <ul class="list-group position-absolute w-100 shadow-sm" style="z-index:1000; max-height:280px; overflow-y:auto;">
                                @foreach (var p in _productosDisponibles)
                                {
                                    <li class="list-group-item list-group-item-action @(p.Id == _productoSeleccionadoId ? "active" : "")"
                                        style="cursor:pointer;"
                                        @onclick="() => SeleccionarProducto(p)">
                                        <div class="d-flex justify-content-between">
                                            <span>
                                                <strong>@p.Nombre</strong>
                                                @if (!string.IsNullOrEmpty(p.CodigoBarras))
                                                {
                                                    <small class="text-muted ms-1">(@p.CodigoBarras)</small>
                                                }
                                            </span>
                                            <span>$@p.Precio.ToString("N2") <small class="text-muted">Stock: @p.Stock</small></span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="form-group mb-2">
                        <label for="cantidad">Cantidad</label>
                        <input id="cantidad" type="number" class="form-control" min="1" max="10000" @bind="_cantidad" />
                    </div>

                    <button class="btn btn-success" @onclick="AgregarDetalle" disabled="@(_isLoading || _productoSeleccionadoId == 0)">
                        @(_isLoading ? "Agregando..." : "Agregar")
                    </button>

                    @if (_productoSeleccionadoId > 0 && _productoSeleccionadoNombre is not null)
                    {
                        <small class="d-block mt-2 text-success">Seleccionado: @_productoSeleccionadoNombre</small>
                    }
                </div>
            </div>
        </div>

        <!-- Cart / Details -->
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">Detalles de la Venta</div>
                <div class="card-body">
                    @if (_detalles.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cant.</th>
                                    <th>P. Unit.</th>
                                    <th>Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _detalles)
                                {
                                    <tr>
                                        <td>@d.ProductoNombre</td>
                                        <td>@d.Cantidad</td>
                                        <td>$@d.PrecioUnitario.ToString("N2")</td>
                                        <td>$@d.Subtotal.ToString("N2")</td>
                                        <td>
                                            <button class="btn btn-sm btn-danger" @onclick="() => EliminarDetalle(d.Id)" disabled="@_isLoading">
                                                X
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No hay productos agregados.</p>
                    }

                    <hr />
                    <h5>Total: $@_total.ToString("N2")</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Cliente Section -->
    @if (_detalles.Any())
    {
        <div class="card mb-3">
            <div class="card-header">Cliente @(RequiereCliente ? "(requerido para cuenta corriente)" : "(opcional)")</div>
            <div class="card-body">
                @if (_clienteSeleccionado is not null)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <span>
                            <strong>@_clienteSeleccionado.Nombre</strong>
                            @if (!string.IsNullOrEmpty(_clienteSeleccionado.Documento))
                            {
                                <small class="text-muted ms-1">(@_clienteSeleccionado.Documento)</small>
                            }
                            @if (_clienteSeleccionado.CuentaCorrienteHabilitada)
                            {
                                <span class="badge bg-success ms-2">Cta. Cte.</span>
                            }
                        </span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="QuitarCliente">Quitar</button>
                    </div>
                }
                else
                {
                    <div class="position-relative">
                        <input type="text" class="form-control" placeholder="Buscar cliente por nombre o documento..."
                               @bind="_busquedaCliente" @bind:event="oninput" @onkeyup="BuscarClientes" autocomplete="off" />
                        @if (_clientesDisponibles.Any())
                        {
                            <ul class="list-group position-absolute w-100 shadow-sm" style="z-index:1000; max-height:240px; overflow-y:auto;">
                                @foreach (var c in _clientesDisponibles)
                                {
                                    <li class="list-group-item list-group-item-action" style="cursor:pointer;"
                                        @onclick="() => SeleccionarCliente(c)">
                                        <strong>@c.Nombre</strong>
                                        @if (!string.IsNullOrEmpty(c.Documento))
                                        {
                                            <small class="text-muted ms-1">(@c.Documento)</small>
                                        }
                                        @if (c.CuentaCorrienteHabilitada)
                                        {
                                            <span class="badge bg-success ms-2">Cta. Cte.</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Payment Section -->
    @if (_detalles.Any())
    {
        <div class="card mb-3">
            <div class="card-header">Medios de Pago</div>
            <div class="card-body">
                @for (int i = 0; i < _pagos.Count; i++)
                {
                    var index = i;
                    <div class="row mb-2">
                        <div class="col-md-5">
                            <select class="form-control" @bind="_pagos[index].MedioPagoId">
                                <option value="0">-- Seleccionar medio --</option>
                                @foreach (var mp in _mediosPago)
                                {
                                    <option value="@mp.Id">@mp.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input type="number" class="form-control" placeholder="Monto" step="0.01" min="0.01"
                                   @bind="_pagos[index].Monto" />
                        </div>
                        <div class="col-md-3">
                            @if (_pagos.Count > 1)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoverPago(index)">Quitar</button>
                            }
                        </div>
                    </div>
                }

                <button class="btn btn-sm btn-outline-secondary mb-2" @onclick="AgregarPago">+ Agregar medio de pago</button>

                <div class="mb-2">
                    <strong>Suma pagos: $@SumaPagos.ToString("N2")</strong>
                    @if (Math.Abs(SumaPagos - _total) > 0.01m && _pagos.Any(p => p.MedioPagoId > 0))
                    {
                        <span class="text-danger ms-2">La suma debe ser igual al total ($@_total.ToString("N2"))</span>
                    }
                </div>

                <button class="btn btn-primary" @onclick="ConfirmarVenta"
                        disabled="@(_isLoading || !PagoValido)">
                    @(_isLoading ? "Confirmando..." : "Confirmar Venta")
                </button>
            </div>
        </div>
    }
}

@code {
    private int? _ventaId;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading;

    // Product search (unificado: código o nombre)
    private string _busquedaProducto = string.Empty;
    private List<ProductoItemDto> _productosDisponibles = new();
    private int _productoSeleccionadoId;
    private string? _productoSeleccionadoNombre;
    private int _cantidad = 1;
    private string? _barcodeMessage;

    // Sale details
    private List<DetalleVentaItemDto> _detalles = new();
    private decimal _total;

    // Payment
    private List<PagoItem> _pagos = new() { new PagoItem() };
    private List<MedioPagoItemDto> _mediosPago = new();

    // Cliente
    private string _busquedaCliente = string.Empty;
    private List<ClienteItemDto> _clientesDisponibles = new();
    private ClienteItemDto? _clienteSeleccionado;

    private decimal SumaPagos => _pagos.Sum(p => p.Monto);

    /// <summary>Indica si algún medio de pago elegido corresponde a cuenta corriente.</summary>
    private bool RequiereCliente => _pagos.Any(p =>
        _mediosPago.FirstOrDefault(m => m.Id == p.MedioPagoId)?.EsCuentaCorriente == true);

    private bool PagoValido => _pagos.All(p => p.MedioPagoId > 0 && p.Monto > 0)
                               && Math.Abs(SumaPagos - _total) <= 0.01m
                               && (!RequiereCliente || _clienteSeleccionado is not null);

    private async Task IniciarVenta()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await Http.PostAsync("api/ventas", null);
            if (response.IsSuccessStatusCode)
            {
                var venta = await response.Content.ReadFromJsonAsync<VentaResponseDto>();
                _ventaId = venta?.Id;
                await CargarMediosPago();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _errorMessage = "No se pudo iniciar la venta. " + body;
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error de conexión al iniciar la venta.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Maneja las teclas del cuadro unificado. Al presionar Enter (lector de código de
    /// barras o confirmación manual) intenta agregar directamente el producto por código
    /// exacto; en otro caso refresca las sugerencias.
    /// </summary>
    private async Task HandleBusquedaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await IntentarAgregarPorCodigo();
            return;
        }

        await BuscarProductos();
    }

    /// <summary>
    /// Busca productos por nombre o código y actualiza las sugerencias en vivo.
    /// </summary>
    private async Task BuscarProductos()
    {
        // Al cambiar el texto se invalida la selección previa.
        _productoSeleccionadoId = 0;
        _productoSeleccionadoNombre = null;
        _barcodeMessage = null;

        if (string.IsNullOrWhiteSpace(_busquedaProducto) || _busquedaProducto.Length < 2)
        {
            _productosDisponibles.Clear();
            return;
        }

        try
        {
            var url = $"api/productos?searchTerm={Uri.EscapeDataString(_busquedaProducto.Trim())}&pageSize=20";
            var result = await Http.GetFromJsonAsync<PaginatedResultDto<ProductoItemDto>>(url);
            _productosDisponibles = result?.Items ?? new();
        }
        catch
        {
            _productosDisponibles.Clear();
        }
    }

    /// <summary>
    /// Intenta resolver el texto ingresado como un código de barras exacto y, de existir,
    /// agrega el producto directamente al carrito (flujo del lector de códigos).
    /// </summary>
    private async Task IntentarAgregarPorCodigo()
    {
        if (string.IsNullOrWhiteSpace(_busquedaProducto))
            return;

        _barcodeMessage = null;
        _isLoading = true;

        try
        {
            var producto = await Http.GetFromJsonAsync<ProductoItemDto>(
                $"api/productos/barcode/{Uri.EscapeDataString(_busquedaProducto.Trim())}");

            if (producto is not null)
            {
                var request = new { ProductoId = producto.Id, Cantidad = 1 };
                var response = await Http.PostAsJsonAsync($"api/ventas/{_ventaId}/detalles", request);

                if (response.IsSuccessStatusCode)
                {
                    await RefrescarDetalles();
                    LimpiarBusqueda();
                }
                else
                {
                    var error = await response.Content.ReadFromJsonAsync<ErrorDto>();
                    _barcodeMessage = error?.Message ?? "Error al agregar producto.";
                }
            }
            else
            {
                _barcodeMessage = "No se encontró un producto con ese código. Seleccioná uno de la lista.";
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            // No es un código exacto: se deja el texto para que el usuario elija de las sugerencias.
            _barcodeMessage = "No se encontró un producto con ese código. Seleccioná uno de la lista.";
            await BuscarProductos();
        }
        catch (Exception)
        {
            _barcodeMessage = "Error al buscar el producto.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Selecciona un producto de las sugerencias para agregarlo con la cantidad indicada.
    /// </summary>
    private void SeleccionarProducto(ProductoItemDto producto)
    {
        _productoSeleccionadoId = producto.Id;
        _productoSeleccionadoNombre = producto.Nombre;
        _busquedaProducto = producto.Nombre;
        _productosDisponibles.Clear();
        _barcodeMessage = null;
    }

    private void LimpiarBusqueda()
    {
        _busquedaProducto = string.Empty;
        _productosDisponibles.Clear();
        _productoSeleccionadoId = 0;
        _productoSeleccionadoNombre = null;
        _barcodeMessage = null;
    }

    private async Task AgregarDetalle()
    {
        if (_productoSeleccionadoId == 0 || _cantidad < 1)
            return;

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var request = new { ProductoId = _productoSeleccionadoId, Cantidad = _cantidad };
            var response = await Http.PostAsJsonAsync($"api/ventas/{_ventaId}/detalles", request);

            if (response.IsSuccessStatusCode)
            {
                await RefrescarDetalles();
                _cantidad = 1;
                LimpiarBusqueda();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorDto>();
                _errorMessage = error?.Message ?? "Error al agregar producto.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error de conexión al agregar producto.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task EliminarDetalle(int detalleId)
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await Http.DeleteAsync($"api/ventas/{_ventaId}/detalles/{detalleId}");
            if (response.IsSuccessStatusCode)
            {
                await RefrescarDetalles();
            }
            else
            {
                _errorMessage = "Error al eliminar detalle.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error de conexión al eliminar detalle.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefrescarDetalles()
    {
        try
        {
            var venta = await Http.GetFromJsonAsync<VentaDetalleDto>($"api/ventas/{_ventaId}");
            if (venta is not null)
            {
                _detalles = venta.Detalles;
                _total = venta.Total;
            }
        }
        catch
        {
            // Keep existing state on failure
        }
    }

    private async Task CargarMediosPago()
    {
        try
        {
            var medios = await Http.GetFromJsonAsync<List<MedioPagoItemDto>>("api/medios-pago");
            _mediosPago = medios ?? new();
        }
        catch
        {
            _mediosPago = new();
        }
    }

    private async Task BuscarClientes(KeyboardEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_busquedaCliente) || _busquedaCliente.Length < 2)
        {
            _clientesDisponibles.Clear();
            return;
        }

        try
        {
            var url = $"api/clientes?searchTerm={Uri.EscapeDataString(_busquedaCliente.Trim())}&pageSize=10";
            var result = await Http.GetFromJsonAsync<PaginatedResultDto<ClienteItemDto>>(url);
            _clientesDisponibles = result?.Items ?? new();
        }
        catch
        {
            _clientesDisponibles.Clear();
        }
    }

    private void SeleccionarCliente(ClienteItemDto cliente)
    {
        _clienteSeleccionado = cliente;
        _busquedaCliente = string.Empty;
        _clientesDisponibles.Clear();
    }

    private void QuitarCliente()
    {
        _clienteSeleccionado = null;
    }

    private void AgregarPago()
    {
        _pagos.Add(new PagoItem());
    }

    private void RemoverPago(int index)
    {
        if (_pagos.Count > 1)
            _pagos.RemoveAt(index);
    }

    private async Task ConfirmarVenta()
    {
        if (!PagoValido)
            return;

        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var request = new
            {
                Pagos = _pagos.Select(p => new { p.MedioPagoId, p.Monto }).ToList(),
                ClienteId = _clienteSeleccionado?.Id
            };

            var response = await Http.PostAsJsonAsync($"api/ventas/{_ventaId}/confirmar", request);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Venta confirmada exitosamente.";
                // Reset state for new sale
                _ventaId = null;
                _detalles.Clear();
                _total = 0;
                _pagos = new() { new PagoItem() };
                _clienteSeleccionado = null;
                _busquedaCliente = string.Empty;
                _clientesDisponibles.Clear();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorDto>();
                _errorMessage = error?.Message ?? "Error al confirmar la venta.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error de conexión al confirmar la venta.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // --- Local DTOs for deserialization ---
    private class VentaResponseDto
    {
        public int Id { get; set; }
    }

    private class ProductoItemDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? CodigoBarras { get; set; }
        public decimal Precio { get; set; }
        public int Stock { get; set; }
    }

    private class DetalleVentaItemDto
    {
        public int Id { get; set; }
        public string ProductoNombre { get; set; } = string.Empty;
        public int Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal Subtotal { get; set; }
    }

    private class VentaDetalleDto
    {
        public int Id { get; set; }
        public decimal Total { get; set; }
        public List<DetalleVentaItemDto> Detalles { get; set; } = new();
    }

    private class MedioPagoItemDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public bool EsCuentaCorriente { get; set; }
    }

    private class ClienteItemDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string? Documento { get; set; }
        public bool CuentaCorrienteHabilitada { get; set; }
    }

    private class PagoItem
    {
        public int MedioPagoId { get; set; }
        public decimal Monto { get; set; }
    }

    private class ErrorDto
    {
        public string? Message { get; set; }
    }

    private class PaginatedResultDto<T>
    {
        public List<T> Items { get; set; } = new();
        public int TotalCount { get; set; }
    }
}
