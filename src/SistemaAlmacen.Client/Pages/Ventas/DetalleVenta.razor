@page "/ventas/{Id:int}"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Detalle de Venta</h3>

<div class="d-flex justify-content-between mb-3">
    <button class="btn btn-outline-secondary" @onclick="Volver">
        &larr; Volver al historial
    </button>

    @if (_venta is not null && EsAnulable)
    {
        <AuthorizeView Roles="Administrador">
            <Authorized>
                <button class="btn btn-danger" @onclick="OpenAnular">
                    <i class="bi bi-x-octagon"></i> Anular venta
                </button>
            </Authorized>
        </AuthorizeView>
    }
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success">@_successMessage</div>
}

@if (_isLoading)
{
    <p>Cargando...</p>
}
else if (_venta is not null)
{
    <div class="card mb-3">
        <div class="card-header">Información General</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <strong>ID Venta:</strong> @_venta.Id
                </div>
                <div class="col-md-3">
                    <strong>Fecha:</strong> @_venta.Fecha.ToString("dd/MM/yyyy HH:mm")
                </div>
                <div class="col-md-3">
                    <strong>Vendedor:</strong> @_venta.Vendedor
                </div>
                <div class="col-md-3">
                    <strong>Estado:</strong>
                    @if (_venta.Estado == EstadoVenta.Anulada)
                    {
                        <span class="badge bg-danger">Anulada</span>
                    }
                    else
                    {
                        @_venta.Estado
                    }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_venta.ClienteNombre))
            {
                <div class="row mt-2">
                    <div class="col-md-6">
                        <strong>Cliente:</strong> @_venta.ClienteNombre
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Products Table -->
    <div class="card mb-3">
        <div class="card-header">Productos</div>
        <div class="card-body">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _venta.Detalles)
                    {
                        <tr>
                            <td>@d.ProductoNombre</td>
                            <td>@d.Cantidad</td>
                            <td>$@d.PrecioUnitario.ToString("N2")</td>
                            <td>$@d.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end"><strong>Total:</strong></td>
                        <td><strong>$@_venta.Total.ToString("N2")</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Payments Table -->
    @if (_venta.Pagos.Any())
    {
        <div class="card mb-3">
            <div class="card-header">Medios de Pago</div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Medio de Pago</th>
                            <th>Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _venta.Pagos)
                        {
                            <tr>
                                <td>@p.MedioPagoNombre</td>
                                <td>$@p.Monto.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    <p class="text-muted">No se encontró la venta solicitada.</p>
}

@* ----- Modal: Anular venta ----- *@
@if (_showAnularModal && _venta is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Anular venta #@_venta.Id</h5>
                    <button type="button" class="btn-close" @onclick="CloseAnular"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        Se repondrá el stock de los productos, se revertirá el ingreso de caja en efectivo
                        y el cargo en cuenta corriente si correspondiera. Esta acción no se puede deshacer.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(_anularError))
                    {
                        <div class="alert alert-danger py-2">@_anularError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Motivo de la anulación *</label>
                        <textarea class="form-control" rows="2" maxlength="250" @bind="_anularMotivo"
                                  placeholder="Ej: error de carga, devolución del cliente..."></textarea>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="emitirNC" @bind="_emitirNotaCredito" />
                        <label class="form-check-label" for="emitirNC">
                            Emitir nota de crédito AFIP (si la venta tiene factura emitida)
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseAnular" disabled="@_anularProcessing">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmAnular" disabled="@_anularProcessing">
                        @(_anularProcessing ? "Anulando..." : "Confirmar anulación")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private VentaDetalleCompletoItemDto? _venta;
    private bool _isLoading;
    private string? _errorMessage;
    private string? _successMessage;

    // Anulación
    private bool _showAnularModal;
    private string _anularMotivo = string.Empty;
    private bool _emitirNotaCredito = true;
    private string? _anularError;
    private bool _anularProcessing;

    private bool EsAnulable => _venta is not null &&
        (_venta.Estado == EstadoVenta.Confirmada || _venta.Estado == EstadoVenta.PendienteFacturacion);

    protected override async Task OnInitializedAsync()
    {
        await CargarVenta();
    }

    private async Task CargarVenta()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _venta = await Http.GetFromJsonAsync<VentaDetalleCompletoItemDto>($"api/ventas/{Id}");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _errorMessage = "Venta no encontrada.";
        }
        catch (Exception)
        {
            _errorMessage = "Error al cargar el detalle de la venta.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/ventas/historial");
    }

    private void OpenAnular()
    {
        _anularMotivo = string.Empty;
        _emitirNotaCredito = true;
        _anularError = null;
        _showAnularModal = true;
    }

    private void CloseAnular()
    {
        _showAnularModal = false;
    }

    private async Task ConfirmAnular()
    {
        _anularError = null;

        if (string.IsNullOrWhiteSpace(_anularMotivo) || _anularMotivo.Trim().Length < 3)
        {
            _anularError = "El motivo debe tener al menos 3 caracteres.";
            return;
        }

        _anularProcessing = true;

        try
        {
            var request = new AnularVentaRequest
            {
                Motivo = _anularMotivo.Trim(),
                EmitirNotaCredito = _emitirNotaCredito
            };

            var response = await Http.PostAsJsonAsync($"api/ventas/{Id}/anular", request);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Venta anulada correctamente.";
                _showAnularModal = false;
                await CargarVenta();
            }
            else
            {
                var errorResult = await ApiErrorParser.ParseAsync(response);
                _anularError = errorResult.GeneralError ?? "Error al anular la venta.";
            }
        }
        catch (Exception)
        {
            _anularError = "Error de conexión. Intente nuevamente.";
        }
        finally
        {
            _anularProcessing = false;
        }
    }

    // --- Local DTOs ---
    private class VentaDetalleCompletoItemDto
    {
        public int Id { get; set; }
        public DateTime Fecha { get; set; }
        public decimal Total { get; set; }
        public EstadoVenta Estado { get; set; }
        public string Vendedor { get; set; } = string.Empty;
        public string? ClienteNombre { get; set; }
        public List<DetalleItemDto> Detalles { get; set; } = new();
        public List<PagoItemDto> Pagos { get; set; } = new();
    }

    private class DetalleItemDto
    {
        public int Id { get; set; }
        public string ProductoNombre { get; set; } = string.Empty;
        public int Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal Subtotal { get; set; }
    }

    private class PagoItemDto
    {
        public string MedioPagoNombre { get; set; } = string.Empty;
        public decimal Monto { get; set; }
    }
}
