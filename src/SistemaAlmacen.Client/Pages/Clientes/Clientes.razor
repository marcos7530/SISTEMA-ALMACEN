@page "/clientes"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Gestión de Clientes</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="alert alert-success" role="alert">@_successMessage</div>
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <input type="text" class="form-control" style="max-width: 320px;"
           placeholder="Buscar por nombre, documento o email..."
           @bind="_searchTerm" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />

    <select class="form-select" style="max-width: 160px;" @bind="_estadoFiltro" @bind:after="ApplyFilter">
        <option value="activos">Activos</option>
        <option value="inactivos">Inhabilitados</option>
        <option value="todos">Todos</option>
    </select>

    <div class="form-check mb-0">
        <input class="form-check-input" type="checkbox" id="soloCC" @bind="_soloCuentaCorriente" @bind:after="ApplyFilter" />
        <label class="form-check-label" for="soloCC">Solo cta. cte.</label>
    </div>

    <button class="btn btn-outline-primary" @onclick="ApplyFilter">Buscar</button>

    <button class="btn btn-primary ms-auto" @onclick="NavigateToCreate">Nuevo Cliente</button>
</div>

@if (_isLoading)
{
    <p>Cargando clientes...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Documento</th>
                <th>Cond. IVA</th>
                <th>Cta. Cte.</th>
                <th class="text-end">Saldo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in _clientes)
            {
                <tr>
                    <td>@cliente.Nombre</td>
                    <td>@(string.IsNullOrEmpty(cliente.Documento) ? "-" : cliente.Documento)</td>
                    <td>@FormatCondicionIva(cliente.CondicionIva)</td>
                    <td>
                        @if (cliente.CuentaCorrienteHabilitada)
                        {
                            <span class="badge bg-success">Habilitada</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td class="text-end @(cliente.SaldoCuentaCorriente > 0 ? "text-danger fw-bold" : "")">
                        @(cliente.CuentaCorrienteHabilitada ? cliente.SaldoCuentaCorriente.ToString("C2") : "-")
                    </td>
                    <td>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   checked="@cliente.Activo"
                                   disabled="@(_togglingId == cliente.Id)"
                                   @onchange="@(e => CambiarEstado(cliente, (bool)e.Value!))" />
                            <span class="@(cliente.Activo ? "text-success" : "text-muted")">
                                @(cliente.Activo ? "Habilitado" : "Inhabilitado")
                            </span>
                        </div>
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            @if (cliente.CuentaCorrienteHabilitada)
                            {
                                <button class="btn btn-info btn-sm text-nowrap" @onclick="() => NavigateToCuentaCorriente(cliente.Id)">
                                    <i class="bi bi-wallet2"></i> Cta. Cte.
                                </button>
                            }
                            <button class="btn btn-warning btn-sm" @onclick="() => NavigateToEdit(cliente.Id)">Editar</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_clientes.Count == 0)
    {
        <p class="text-muted">No se encontraron clientes.</p>
    }

    @if (_totalPages > 1)
    {
        <nav aria-label="Paginación de clientes">
            <ul class="pagination">
                <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="PreviousPage" disabled="@(_currentPage <= 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= _totalPages; i++)
                {
                    var pageNum = i;
                    <li class="page-item @(_currentPage == pageNum ? "active" : "")">
                        <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    </li>
                }
                <li class="page-item @(_currentPage >= _totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="NextPage" disabled="@(_currentPage >= _totalPages)">Siguiente</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private List<ClienteDto> _clientes = new();
    private string? _searchTerm;
    private bool _soloCuentaCorriente;
    private string _estadoFiltro = "activos"; // activos | inactivos | todos
    private int _currentPage = 1;
    private int _totalPages;
    private const int PageSize = 10;
    private bool _isLoading = true;
    private int? _togglingId;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientes();
    }

    private async Task LoadClientes()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var queryParams = new List<string>
            {
                $"page={_currentPage}",
                $"pageSize={PageSize}",
                $"soloCuentaCorriente={_soloCuentaCorriente.ToString().ToLower()}"
            };

            if (!string.IsNullOrWhiteSpace(_searchTerm))
                queryParams.Add($"searchTerm={Uri.EscapeDataString(_searchTerm)}");

            // Filtro de estado: activos (true), inactivos (false), todos (sin parámetro).
            if (_estadoFiltro == "activos")
                queryParams.Add("activo=true");
            else if (_estadoFiltro == "inactivos")
                queryParams.Add("activo=false");

            var url = $"api/clientes?{string.Join("&", queryParams)}";
            var result = await Http.GetFromJsonAsync<PaginatedResult<ClienteDto>>(url);

            if (result is not null)
            {
                _clientes = result.Items;
                _totalPages = result.TotalPages;
            }
            else
            {
                _clientes = new();
                _totalPages = 0;
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error al cargar los clientes. Intente nuevamente.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatCondicionIva(CondicionIva c) => c switch
    {
        CondicionIva.ConsumidorFinal => "Consumidor Final",
        CondicionIva.ResponsableInscripto => "Responsable Inscripto",
        CondicionIva.Monotributista => "Monotributista",
        CondicionIva.Exento => "Exento",
        _ => c.ToString()
    };

    private async Task ApplyFilter()
    {
        _currentPage = 1;
        await LoadClientes();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ApplyFilter();
    }

    private async Task GoToPage(int page) { _currentPage = page; await LoadClientes(); }
    private async Task PreviousPage() { if (_currentPage > 1) { _currentPage--; await LoadClientes(); } }
    private async Task NextPage() { if (_currentPage < _totalPages) { _currentPage++; await LoadClientes(); } }

    private void NavigateToCreate() => Navigation.NavigateTo("/clientes/crear");
    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/clientes/editar/{id}");
    private void NavigateToCuentaCorriente(int id) => Navigation.NavigateTo($"/clientes/{id}/cuenta-corriente");

    private async Task CambiarEstado(ClienteDto cliente, bool nuevoEstado)
    {
        _togglingId = cliente.Id;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var request = new CambiarEstadoRequest { Activo = nuevoEstado };
            var response = await Http.PatchAsJsonAsync($"api/clientes/{cliente.Id}/estado", request);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = nuevoEstado
                    ? $"Cliente '{cliente.Nombre}' habilitado."
                    : $"Cliente '{cliente.Nombre}' inhabilitado.";
                await LoadClientes();
            }
            else
            {
                // Falló: recargar para revertir el switch al estado real y mostrar el motivo.
                var errorResult = await ApiErrorParser.ParseAsync(response);
                _errorMessage = errorResult.GeneralError ?? "No se pudo cambiar el estado del cliente.";
                await LoadClientes();
            }
        }
        catch (Exception)
        {
            _errorMessage = "Error de conexión. Intente nuevamente.";
            await LoadClientes();
        }
        finally
        {
            _togglingId = null;
        }
    }
}
