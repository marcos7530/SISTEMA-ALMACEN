@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="page">
    <AuthorizeView>
        <Authorized Context="layoutAuth">
            <div class="sidebar">
                <NavMenu />
            </div>
        </Authorized>
    </AuthorizeView>

    <main>
        <AuthorizeView>
            <Authorized Context="topBarAuth">
                <div class="top-row">
                    <span><i class="bi bi-person-circle"></i> @topBarAuth.User.Identity?.Name</span>
                    <button class="btn btn-sm btn-outline-danger" @onclick="Logout">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>

        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private async Task Logout()
    {
        var provider = (JwtAuthenticationStateProvider)AuthStateProvider;
        await provider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login");
    }
}
